# Copy to .env (never commit .env) and fill in real values.
ENVIRONMENT=development
# Role/database/schema are created by sql/setup_database.sql; tables live in schema daily_spend
# (set as the role's search_path). Run `alembic upgrade head` after creating them.
DATABASE_URL=postgresql+psycopg://daily_spend_app:change-me@localhost:5432/daily_spend
# Optional: run pytest against PostgreSQL (empty database, migrated up and down by the tests)
TEST_DATABASE_URL=postgresql+psycopg://daily_spend_app:change-me@localhost:5432/daily_spend_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=43200
# Google sign-in: the OAuth *Web* client id(s) from Google Cloud Console, comma separated.
# ID tokens from the app must be issued for one of these. Not secret.
GOOGLE_CLIENT_IDS=
LOG_LEVEL=INFO
# JSON list, only needed for browser clients
CORS_ORIGINS=[]
# Pro by UPI. Your UPI id (a merchant/business UPI id works best: personal ids can be refused
# by some UPI apps for payments with a pre-filled amount). Empty = Pro can't be bought.
PRO_UPI_ID=
PRO_UPI_NAME=MyExpenses
# Prices in paise (4900 = ₹49).
PRO_PRICE_MONTHLY_MINOR=4900
PRO_PRICE_YEARLY_MINOR=39900
